<%= render(Primer::Alpha::ActionMenu.new(menu_id: "deferred", preload: preload, src: primer_view_components.action_menu_deferred_path)) do |menu| %>
  <% menu.with_show_button { "Menu with refreshable content" } %>
<% end %>

<%= render(Primer::Beta::Button.new(id: "deferred-refresh-button", ml: 2)) { "Refresh" } %>

<%# Used by the "Show dialog" item rendered by ActionMenuController#deferred. %>
<%= render(Primer::Alpha::Dialog.new(id: "my-dialog", title: "Confirm deletion")) do |d| %>
  <%= render(Primer::Alpha::Dialog::Body.new()) do %>
    Are you sure you want to delete this?
  <% end %>
  <%= render(Primer::Alpha::Dialog::Footer.new()) do %>
    <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "my-dialog" })) { "Cancel" } %>
    <%= render(Primer::Beta::Button.new(scheme: :danger)) { "Delete" } %>
  <% end %>
<% end %>

<script type="text/javascript">
  (() => {
    let count = 0
    document.getElementById("deferred-refresh-button").addEventListener("click", () => {
      const menu = document.querySelector("action-menu")
      const url = new URL(menu.getAttribute("src"), window.location.href)
      count += 1
      url.searchParams.set("label", `Refreshed ${count}`)
      menu.setAttribute("src", `${url.pathname}${url.search}`)
    })
  })()
</script>
