<%= render(Primer::Alpha::ActionMenu::List.new(menu_id: "deferred")) do |list| %>
  <% if @label.present? %>
    <% list.with_item(label: @label, value: "", autofocus: true) %>
  <% end %>
  <% list.with_item(label: "Copy link", value: "", autofocus: @label.blank?) %>
  <% list.with_item(label: "Quote reply", value: "") %>
  <% list.with_item(label: "Reference in new issue", value: "") %>
  <% list.with_item(
    label: "Show dialog",
    tag: :button,
    # this dialog is rendered by demo/app/views/action_menu/deferred.html.erb
    content_arguments: { "data-show-dialog-id": "my-dialog" },
    value: "",
    scheme: :danger
  ) %>
  <% if @deferred_sub %>
    <% list.with_item(component_klass: Primer::Alpha::ActionMenu::SubMenuItem, label: "Deferred more", src: primer_view_components.action_menu_deferred_path) %>
  <% end %>
<% end %>
