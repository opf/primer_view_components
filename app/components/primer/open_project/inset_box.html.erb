<%= render(
      Primer::Box.new(
        border: @border,
        border_radius: 2,
        p: 3,
        **@scheme_arguments,
        **@system_arguments
      )
    ) do %>
  <% if title? || title_icon? %>
    <div class="InsetBox--title-container">
      <%= title_icon %>
      <%= title %>
    </div>
  <% end %>

  <%= render(Primer::OpenProject::GridLayout.new(css_class: "InsetBox--body", tag: :div)) do |grid| %>
    <% if clipboard_copy_button?
         grid.with_area(:clip_board_copy) do
           render(clipboard_copy_button)
         end
       end %>

    <% grid.with_area(:content, overflow: :hidden) do
         content
       end %>

    <% if actions.any? %>
      <% grid.with_area(:actions) do %>
        <%= render(
              Primer::Box.new(
                display: :flex,
                align_items: :center,
                flex_wrap: :wrap,
                mt: 2,
                classes: "InsetBox--actions"
              )
            ) do %>
          <% actions.each do |action| %>
            <%= action %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
